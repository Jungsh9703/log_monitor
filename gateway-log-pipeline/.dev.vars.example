# Copy to .dev.vars for local `wrangler dev`, or fill in via the
# "Deploy to Cloudflare" button's setup screen. All of these are optional --
# the Worker runs fine without them, it just won't be able to reach a
# Basic-Auth-protected or Cloudflare-Access-protected Loki endpoint.
# (LOKI_USERNAME is not a secret -- it lives in wrangler.toml's [vars]
# instead, since it's just an identifier, not sensitive.)

# The htpasswd password for LOKI_USERNAME (see ../loki-grafana-azure-vm),
# i.e. the primary auth path for the current no-domain nginx setup.
LOKI_API_KEY=

# Cloudflare Access Service Token -- only relevant if a domain + Cloudflare
# Tunnel + Access fronts Loki instead of nginx Basic Auth.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Shared secret gating the manual POST /run?token=... test endpoint. Leave
# blank to allow unauthenticated manual triggers (fine for local dev only).
RUN_TOKEN=
