# Copy to .dev.vars for local `wrangler dev`, or fill in via the
# "Deploy to Cloudflare" button's setup screen. All of these are optional --
# the Worker runs fine without them, it just won't be able to reach a
# Cloudflare-Access-protected or Basic-Auth-protected Loki endpoint.

# Cloudflare Access Service Token, if the Loki push endpoint (on the Azure
# VM, see ../loki-grafana-azure-vm) sits behind a Cloudflare Tunnel + Access
# application. Recommended over LOKI_USERNAME/LOKI_API_KEY.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Plain Basic Auth pair, only needed if the Loki endpoint uses that instead
# of Cloudflare Access.
LOKI_USERNAME=
LOKI_API_KEY=

# Shared secret gating the manual POST /run?token=... test endpoint. Leave
# blank to allow unauthenticated manual triggers (fine for local dev only).
RUN_TOKEN=
