# Copy to /etc/loki/loki.env (chmod 600, owned by root) -- never commit the
# filled-in version. Referenced by systemd/loki-override.conf's
# EnvironmentFile, and expanded into loki-config.yml's storage_config.azure
# block via -config.expand-env=true.

AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=loki-data
