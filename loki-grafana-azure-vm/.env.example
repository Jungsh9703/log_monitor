# Copy to .env and fill in -- .env is gitignored, never commit real values.

# Azure Storage account backing Loki's chunk/index storage (see README step 1).
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=loki-data

# Token for the Cloudflare Tunnel created in the Zero Trust dashboard
# (Networks > Tunnels > Create a tunnel > Docker) -- paste the token shown
# there, not the tunnel ID.
TUNNEL_TOKEN=

# Base domain used for the tunnel's public hostnames (grafana.$DOMAIN,
# loki-push.$DOMAIN), must be a zone already on this Cloudflare account.
DOMAIN=example.com
