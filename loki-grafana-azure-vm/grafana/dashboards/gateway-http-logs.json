{
  "title": "Gateway HTTP Logs (All Traffic)",
  "uid": "gateway-http-logs",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "identity",
        "label": "User",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=\"gateway_http_logs\"} | json, identity)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total requests (last 1h)",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"gateway_http_logs\"} | json | identity=~\"$identity\" [1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests over time by action",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (action) (count_over_time({job=\"gateway_http_logs\"} | json | identity=~\"$identity\" [$__interval]))",
          "refId": "A",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Top hosts by traffic (last 1h)",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "topk(10, sum by (host) (count_over_time({job=\"gateway_http_logs\"} | json | host != \"\" | identity=~\"$identity\" [1h])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Status code distribution (last 1h)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (status_code) (count_over_time({job=\"gateway_http_logs\"} | json | status_code != \"\" | identity=~\"$identity\" [1h]))",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top blocked/isolated policies (last 1h)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (policy_name) (count_over_time({job=\"gateway_http_logs\", action!=\"allow\"} | json | policy_name != \"\" | identity=~\"$identity\" [1h]))",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Recent log lines",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{job=\"gateway_http_logs\"} | json | identity=~\"$identity\"",
          "refId": "A"
        }
      ]
    }
  ]
}
